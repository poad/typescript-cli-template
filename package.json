{
  "name": "typescript-cli-template",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Kenji Saito <ken-yo@mbr.nifty.com>",
  "repository": "git@github.com:poad/typescript-cli-template.git",
  "bin": {
    "typescript-cli-template": "./bin/cli.js"
  },
  "type": "module",
  "main": "cli.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "swc --delete-dir-on-start src -d dist",
    "dev": "swc --watch src -d dist",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "package": "echo Skip the packaging process",
    "all": "pnpm lint && pnpm format-check && pnpm test"
  },
  "dependencies": {
    "arg": "^5.0.2"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "^0.5.23",
    "@types/node": "^26.6.6",
    "chokidar": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "jiti": "^2.7.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "regenerator-runtime": "^0.14.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  }
}
